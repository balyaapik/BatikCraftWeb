  "security_review": {
    "controls_passed": [
      "CSRF protection (CsrfViewMiddleware + @csrf_exempt on webhook with token auth)",
      "Webhook HMAC token verification (constant-time hmac.compare_digest)",
      "Session security (HttpOnly, Secure, SameSite=Lax, HSTS 1yr with preload)",
      "Role-based access control (buyer/creator separation at every view)",
      "Payment proof file upload (extension allowlist + 10MB cap)",
      "File download authorisation (all files streamed through Django after check)",
      "Webhook idempotency (SHA-256 event_key in PaymentGatewayEvent)",
      "Settlement concurrency (select_for_update + transaction.atomic everywhere)",
      "Secret key protection (ImproperlyConfigured at boot with insecure key + DEBUG=False)"
    ],
    "controls_failed": [
      "API rate limiting absent on /api/v1/auth/token/",
      "Xendit gateway credentials stored as plain text (partial encryption gap)"
    ]
  },

